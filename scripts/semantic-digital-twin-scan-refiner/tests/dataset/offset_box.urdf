<?xml version="1.0"?>
<robot name="inspection_test">
  <link name="root"/>
  <link name="box">
    <visual>
      <origin xyz="0.2 0 0"/>
      <geometry><box size="2 1 0.4"/></geometry>
    </visual>
    <collision>
      <geometry><box size="1.6 0.8 0.2"/></geometry>
    </collision>
  </link>
  <joint name="mount" type="fixed">
    <parent link="root"/>
    <child link="box"/>
    <origin xyz="1 2 0.3"/>
  </joint>
</robot>
