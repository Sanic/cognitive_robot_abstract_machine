<?xml version="1.0"?>
<robot name="test">
  <link name="root"/>
  <link name="box"><visual><origin xyz="0.1 0 0"/><geometry><box size="1 .6 .4"/></geometry><material name="wood"><color rgba=".6 .3 .1 1"/></material></visual><collision><origin xyz="0.1 0 0"/><geometry><box size=".98 .58 .38"/></geometry></collision></link>
  <joint name="mount" type="fixed"><parent link="root"/><child link="box"/><origin xyz=".2 .3 .4" rpy="0 0 .3"/></joint>
  <link name="handle"><visual><geometry><box size=".1 .02 .02"/></geometry></visual></link>
  <joint name="handle_mount" type="fixed"><parent link="box"/><child link="handle"/><origin xyz=".1 0 .3"/></joint>
  <link name="door"><visual><geometry><box size=".4 .05 .6"/></geometry></visual></link>
  <joint name="hinge" type="revolute"><parent link="root"/><child link="door"/><origin xyz="1 0 0"/><axis xyz="0 0 1"/><limit lower="0" upper="1.5" effort="10" velocity="1"/></joint>
</robot>
